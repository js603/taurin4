{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "outDir": ".core-dist",
    "rootDir": ".",
    "lib": [
      "ES2022",
      "DOM"
    ]
  },
  "include": [
    "src/features/medieval-trial/**/*.ts",
    "src/features/mafia-classic/core/**/*.ts",
    "src/features/mafia-classic/simulation/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts"
  ],
  "exclude": [
    "src/features/medieval-trial/application/trialSession.ts",
    "src/features/medieval-trial/application/trialSessionTypes.ts",
    "src/features/medieval-trial/application/**/*.test.ts",
    "src/features/medieval-trial/ui/**/*",
    "src/features/mafia-classic/core/**/*.test.ts",
    "src/features/mafia-classic/ui/**/*"
  ]
}
