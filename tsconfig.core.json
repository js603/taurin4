{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true,
    "outDir": ".core-dist",
    "rootDir": ".",
    "lib": ["ES2022", "DOM"]
  },
  "include": [
    "src/features/medieval-trial/**/*.ts",
    "tests/**/*.ts",
    "types/**/*.d.ts"
  ]
}
