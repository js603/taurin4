{
  "name": "taurin4",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "core:build": "node -e \"require('node:fs').rmSync('.core-dist',{recursive:true,force:true})\" && tsc -p tsconfig.core.json",
    "core:test": "npm run core:build && node --test .core-dist/tests/run-tests.js",
    "balance:run": "npm run core:build && node .core-dist/src/features/medieval-trial/simulation/cli.js",
    "balance:50k": "npm run core:build && node .core-dist/src/features/medieval-trial/simulation/cli.js --games 50000 --seed 20260918",
    "balance:profiles": "npm run core:build && node .core-dist/src/features/medieval-trial/simulation/cli.js --games 10000 --profile lowInfo && node .core-dist/src/features/medieval-trial/simulation/cli.js --games 10000 --profile baseline && node .core-dist/src/features/medieval-trial/simulation/cli.js --games 10000 --profile highInfo",
    "check": "npm run lint && npm run test && npm run core:test && npm run build",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build:debug": "tauri android build --debug --apk",
    "android:build:release": "tauri android build --apk --aab",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build:unsigned": "tauri ios build --no-sign",
    "ios:build:release": "tauri ios build --export-method app-store-connect",
    "mafia:m1:sim": "npm run core:build && node .core-dist/src/features/mafia-classic/simulation/cli.js --games 1000 --seed 20260921",
    "mafia:m1:sim:10k": "npm run core:build && node .core-dist/src/features/mafia-classic/simulation/cli.js --games 10000 --seed 20260921",
    "mafia:m2:contracts": "vitest run --config vitest.config.ts src/features/mafia-classic/ux"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-store": "2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^26.6.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0"
  }
}
