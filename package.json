{
  "name": "taurin4",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run lint && npm run test && npm run build",
    "openmmo:codec": "node scripts/prepare-openmmo-codec.mjs",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "android:init": "tauri android init",
    "android:dev": "tauri android dev",
    "android:build:debug": "tauri android build --debug --apk",
    "android:build:release": "tauri android build --apk --aab",
    "ios:init": "tauri ios init",
    "ios:dev": "tauri ios dev",
    "ios:build:unsigned": "tauri ios build --no-sign",
    "ios:build:release": "tauri ios build --export-method app-store-connect",
    "openmmo:play:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/play-openmmo-windows.ps1"
  },
  "dependencies": {
    "@tauri-apps/api": "2.11.1",
    "@tauri-apps/plugin-store": "2.4.5",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "zod": "^4.0.0",
    "@tauri-apps/plugin-websocket": "2.4.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@tauri-apps/cli": "2.11.4",
    "@types/node": "^26.6.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^16.0.0",
    "prettier": "^3.0.0",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.0.0",
    "vite": "8.3.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0"
  }
}
