+  async moveCollectionItem(fromCollectionId:string,toCollectionId:string,postId:string) {
+    if(fromCollectionId===toCollectionId)return {ok:true};
+    const body={postId,toCollectionId};
+    if(this.online() && !this.localSession()){
+      try{return await this.raw<{ok:boolean}>(`/v1/collections/${fromCollectionId}/move`,{method:"POST",body:JSON.stringify(body)});}
+      catch(error){if(!isNetworkFailure(error)) throw error;}
+    }
+    if(!this.localSession()) await this.enqueue("POST",`/v1/collections/${fromCollectionId}/move`,body);
+    await localDb.localMoveCollectionItem(fromCollectionId,toCollectionId,postId);
+    const collections=await localDb.localCollections();
+    await localDb.cacheSet("collections",{items:collections});
+    for(const collection of collections){
+      await localDb.cacheSet(`collection:${collection.id}`,{collection});
+    }
+    return {ok:true};
+  }
