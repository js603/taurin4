+    const conn=await db();
+    if(!conn){
+      const map=browserGet<Record<string,string[]>>("domain","collectionItems")??{};
+      map[toCollectionId]=Array.from(new Set([...(map[toCollectionId]??[]),postId]));
+      map[fromCollectionId]=(map[fromCollectionId]??[]).filter(id=>id!==postId);
+      browserSet("domain","collectionItems",map);
+      return;
+    }
+    await conn.execute("BEGIN IMMEDIATE");
+    try{
+      await conn.execute("INSERT OR IGNORE INTO local_collection_items(collection_id,post_id,created_at) VALUES($1,$2,$3)",[toCollectionId,postId,Date.now()]);
+      await conn.execute("DELETE FROM local_collection_items WHERE collection_id=$1 AND post_id=$2",[fromCollectionId,postId]);
+      await conn.execute("COMMIT");
+    }catch(error){
+      try{await conn.execute("ROLLBACK")}catch{}
+      throw error;
+    }
+  },
