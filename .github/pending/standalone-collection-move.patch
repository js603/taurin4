   async localCollectionItems(collectionId:string): Promise<Post[]> {
     const conn=await db();
     if(!conn){const ids=(browserGet<Record<string,string[]>>("domain","collectionItems")??{})[collectionId]??[];const posts=await this.localPosts();return ids.map(id=>posts.find(p=>p.id===id)).filter(Boolean) as Post[];}
