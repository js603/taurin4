    <div ref={completionRef} className="reading-complete-marker" aria-hidden="true" />
    {!editing&&<div className="reading-actions"><button onClick={()=>onCollect(p)}>{p.collected?'간직됨':'간직하기'}</button><button onClick={share}>공유</button>{!mine&&<button onClick={()=>onProfile(p.author.handle)}>이 사람 계속 읽기</button>}</div>}
    {mine?<div className="moderation-actions"><button onClick={()=>setEditing(true)}>수정</button><button onClick={remove}>삭제</button>{message&&<span>{message}</span>}</div>:<div className="moderation-actions"><button onClick={report}>신고</button><button onClick={block}>작성자 차단</button>{message&&<span>{message}</span>}</div>}</article>
    {!editing&&<section className="comments"><h2>남겨진 한마디</h2>{detail?.comments.map(c=><div className="comment" key={c.id}><strong>{c.author.penName}</strong><p>{c.content}</p></div>)}<div className="comment-form"><input value={comment} onChange={e=>setComment(e.target.value)} placeholder="짧은 마음을 남겨보세요."/><button onClick={send}>남기기</button></div></section>}</div></div>;
}

function PublicCollectionView({id,onClose,onOpen,onCollect,onProfile}:{id:string;onClose:()=>void;onOpen:(p:Post)=>void;onCollect:(p:Post)=>void;onProfile:(h:string)=>void}) {
  const [collection,setCollection]=useState<Collection|null>(null); const [error,setError]=useState('');
  useEffect(()=>{api.collection(id).then(r=>setCollection(r.collection)).catch(e=>setError(e.message))},[id]);
  return <div className="overlay"><div className="overlay-sheet"><button className="back" onClick={onClose}>← 발견</button>{error?<Empty title="서랍을 열 수 없습니다." body={error}/>:collection?<><div className="section-heading"><p className="date">공개 서랍</p><h1>{collection.title}</h1><p>{collection.description||`${collection.itemCount}개의 문장`}</p></div>{collection.items?.map(p=><PostCard key={p.id} post={p} onOpen={onOpen} onCollect={onCollect} onProfile={onProfile}/>)}</>:<div className="skeleton-block"/>}</div></div>;
}

function ProfileView({handle,onClose,onOpen}:{handle:string;onClose:()=>void;onOpen:(p:Post)=>void}) {
  const [data,setData]=useState<{profile:Profile;posts:Post[]}|null>(null); useEffect(()=>{api.profile(handle).then(setData);api.event('profile_open')},[handle]);
  async function follow(){if(!data)return;const r=await api.toggleFollow(data.profile.id);setData(d=>d?{...d,profile:{...d.profile,following:r.following}}:d)}
  return <div className="overlay"><div className="overlay-sheet"><button className="back" onClick={onClose}>← 돌아가기</button>{data?<><div className="profile-header"><div className="avatar">{data.profile.penName.slice(0,1)}</div><div><h1>{data.profile.penName}</h1><p>@{data.profile.handle}</p><p>{data.profile.tagline}</p><button className="follow" onClick={follow}>{data.profile.following?'계속 읽는 중':'계속 읽기'}</button></div></div><h2 className="subhead">이 사람이 남긴 문장</h2>{data.posts.map(p=><button className="profile-post" key={p.id} onClick={()=>onOpen(p)}>{p.leadSentence||p.content}</button>)}</>:<div className="skeleton-block"/>}</div></div>;
}

function Notifications({items,onClose}:{items:NotificationItem[];onClose:()=>void}) {return <div className="overlay"><div className="overlay-sheet"><button className="back" onClick={onClose}>← 돌아가기</button><h1>알림</h1><div className="notification-list">{items.length?items.map(n=><div key={n.id}><p>{n.message}</p><span>{new Date(n.createdAt).toLocaleString('ko-KR')}</span></div>):<Empty title="조용한 하루입니다." body="새 소식이 생기면 이곳에 남겨둘게요."/>}</div></div></div>}

function Settings({onClose,onSignOut}:{onClose:()=>void;onSignOut:()=>void}) {
  const [base,setBase]=useState(api.getBase()); const [status,setStatus]=useState(""); const [deleting,setDeleting]=useState(false);
  async function save(){await persistApiBase(base.trim());setStatus('저장했습니다.');await sleep(250);try{await api.health();setStatus('서버 연결을 확인했습니다.')}catch{setStatus('저장했지만 서버에 연결되지 않았습니다.')}}
  async function removeAccount(){if(!window.confirm('계정을 삭제하면 작성한 글과 활동 데이터가 삭제됩니다. 계속할까요?'))return;setDeleting(true);try{await api.deleteAccount();await localDb.clear();await onSignOut()}finally{setDeleting(false)}}
  return <div className="overlay"><div className="overlay-sheet"><button className="back" onClick={onClose}>← 돌아가기</button><h1>설정</h1>{INTERNAL_TEST&&<div className="settings-block"><label>내부 테스트 API 서버 주소<input value={base} onChange={e=>setBase(e.target.value)} placeholder="http://192.168.0.10:8787"/></label><button onClick={save}>저장하고 확인</button>{status&&<p>{status}</p>}<p className="fine">내부 테스트 전용 기능입니다. 스토어 Release에서는 HTTPS 운영 API가 빌드에 고정되고 이 입력란은 제거됩니다.</p></div>}<button className="danger" onClick={onSignOut}>이 기기에서 로그아웃</button><button className="danger account-delete" disabled={deleting} onClick={removeAccount}>{deleting?'삭제 중':'계정과 데이터 삭제'}</button></div></div>;
}
