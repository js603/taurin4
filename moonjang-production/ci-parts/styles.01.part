1px;line-height:1.4;margin:0 0 28px}.reading-body p{font-family:Georgia,"Noto Serif KR",serif;font-size:19px;line-height:2;word-break:keep-all}.reading-actions{display:flex;gap:10px;padding:30px 0;border-bottom:1px solid var(--line)}.reading-actions button{border:1px solid var(--line);background:transparent;padding:10px 14px}.comments{padding:30px 0}.comment{padding:15px 0;border-bottom:1px solid var(--line)}.comment strong{font-size:12px}.comment p{margin:6px 0;font-size:14px}.comment-form{display:flex;gap:8px;margin-top:18px}.notification-list>div{padding:17px 0;border-bottom:1px solid var(--line)}.notification-list p{margin:0 0 5px}.notification-list span{font-size:11px;color:var(--muted)}.settings-block{display:flex;flex-direction:column;gap:12px;margin:30px 0}.settings-block label{display:flex;flex-direction:column;gap:8px}.danger{border:1px solid #a25a4c;color:#8f4032;background:transparent;padding:11px 14px}.onboarding{min-height:100vh;width:min(100%,760px);margin:0 auto;padding:calc(env(safe-area-inset-top) + 54px) 26px 40px;display:flex;flex-direction:column;justify-content:space-between;gap:45px}.onboarding-copy h1{font-family:Georgia,"Noto Serif KR",serif;font-size:35px;line-height:1.45;letter-spacing:-.04em;margin:25px 0}.onboarding-copy p{color:var(--muted);line-height:1.7}.onboarding-form{display:flex;flex-direction:column;gap:24px}.onboarding-form label{font-size:12px;display:flex;flex-direction:column;gap:4px}.handle-input{display:flex;align-items:center;border-bottom:1px solid var(--line)}.handle-input input{border-bottom:0}.form-error{color:#9a4033;font-size:12px}.empty{text-align:center;padding:60px 20px;color:var(--muted)}.empty strong{color:var(--ink)}.error-banner{position:fixed;left:16px;right:16px;bottom:82px;z-index:60;background:#321f1b;color:white;padding:12px 14px;display:flex;justify-content:space-between;gap:10px}.error-banner button{background:none;border:0;color:white}.toast{position:fixed;left:50%;bottom:90px;transform:translateX(-50%);z-index:60;background:#222;color:white;padding:10px 14px;font-size:12px}.center-screen{min-height:100vh;display:grid;place-content:center;text-align:center;color:var(--muted)}.center-screen .brand{color:var(--ink);font-size:28px}.skeleton-block{height:240px;background:linear-gradient(90deg,#eee6da,#f7f2e9,#eee6da);background-size:200% 100%;animation:shimmer 1.5s infinite}.back{font-size:13px;margin-bottom:22px}@keyframes shimmer{to{background-position:-200% 0}}@media(min-width:800px){.bottom-nav{left:50%;right:auto;width:760px;transform:translateX(-50%)}.content{padding-top:44px}.sentence{font-size:31px}.rail{grid-auto-columns:48%}.onboarding{justify-content:center}.topbar{padding-left:max(22px,calc((100vw - 760px)/2));padding-right:max(22px,calc((100vw - 760px)/2))}}
.visibility-field{display:flex;justify-content:space-between;align-items:center;margin-top:18px;padding:12px 0;border-bottom:1px solid var(--line);font-size:12px;color:var(--muted)}.visibility-field select,.create-row select{border:1px solid var(--line);background:var(--surface);padding:9px 10px;color:var(--ink)}.public-collection-row{display:flex;flex-direction:column;gap:5px;padding:15px 0;border-bottom:1px solid var(--line)}.public-collection-row span{font-size:12px;color:var(--muted)}.moderation-actions{display:flex;gap:16px;align-items:center;padding:13px 0}.moderation-actions button{border:0;background:none;padding:0;color:var(--muted);font-size:11px}.moderation-actions span{font-size:11px;color:var(--accent)}.account-delete{display:block;margin-top:12px;width:100%}
.public-collection-row{width:100%;text-align:left;border:0;border-bottom:1px solid var(--line);background:none}.edit-post{display:flex;flex-direction:column;gap:12px}.edit-post input,.edit-post textarea{width:100%;border:0;border-bottom:1px solid var(--line);background:transparent;outline:none;padding:10px 0}.edit-post textarea{min-height:45vh;resize:vertical;font-family:Georgia,"Noto Serif KR",serif;font-size:19px;line-height:1.9}.edit-post>div{display:flex;justify-content:flex-end;gap:10px}.edit-post button{border:1px solid var(--line);background:transparent;padding:9px 13px}.reading-complete-marker{height:2px}
