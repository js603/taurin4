  if(path==='/v1/reports'&&method==='POST'){const d=await body(req),pid=String(d.postId||''),reason=String(d.reason||'').trim().slice(0,500);if(!pid||!reason)return json({error:'신고 사유를 입력해주세요.'},400);await env.DB.prepare('INSERT INTO reports(id,reporter_id,post_id,reason,created_at) VALUES(?,?,?,?,?)').bind(uuid(),uid,pid,reason,now()).run();return json({ok:true},201);}
  m=path.match(/^\/v1\/blocks\/([^/]+)$/);if(m&&method==='POST'){const old=await env.DB.prepare('SELECT 1 x FROM blocks WHERE blocker_id=? AND blocked_id=?').bind(uid,m[1]).first();let blocked;if(old){await env.DB.prepare('DELETE FROM blocks WHERE blocker_id=? AND blocked_id=?').bind(uid,m[1]).run();blocked=false}else{await env.DB.prepare('INSERT INTO blocks(blocker_id,blocked_id,created_at) VALUES(?,?,?)').bind(uid,m[1],now()).run();blocked=true}return json({blocked});}
  if(path==='/v1/events'&&method==='POST'){const d=await body(req);let kind=String(d.kind||'').slice(0,40);if(!new Set(['impression','open','read_complete','revisit','profile_open','collection','share']).has(kind))return json({error:'지원하지 않는 이벤트입니다.'},400);if(kind==='open'&&d.postId){const seen=await env.DB.prepare("SELECT 1 x FROM events WHERE user_id=? AND post_id=? AND kind IN ('open','read_complete','revisit') LIMIT 1").bind(uid,d.postId).first();if(seen)kind='revisit'}await env.DB.prepare('INSERT INTO events(user_id,post_id,kind,created_at) VALUES(?,?,?,?)').bind(uid,d.postId||null,kind,now()).run();return json({ok:true},201);}
  if(path==='/v1/admin/reports'&&method==='GET'){if(!env.ADMIN_KEY||req.headers.get('X-Admin-Key')!==env.ADMIN_KEY)return json({error:'관리자 권한이 없습니다.'},403);const rows=(await env.DB.prepare("SELECT r.*,u.handle reporter,p.content FROM reports r JOIN users u ON u.id=r.reporter_id JOIN posts p ON p.id=r.post_id WHERE r.status='open' ORDER BY r.created_at").all<Row>()).results;return json({items:rows});}
  return json({error:'경로를 찾을 수 없습니다.'},404);
}

const MUTATION_METHODS=new Set(['POST','PUT','PATCH','DELETE']);
async function idempotentRoute(req:Request,env:Env):Promise<Response>{
  const mutationId=(req.headers.get('X-Moonjang-Mutation-Id')||'').trim().slice(0,120);
  const path=new URL(req.url).pathname;
  if(!mutationId||!MUTATION_METHODS.has(req.method)||path==='/v1/auth/anonymous')return route(req,env);
  const user=await userFrom(req,env),uid=user.id as string;
  const prior=await env.DB.prepare('SELECT status,response_json FROM mutation_receipts WHERE user_id=? AND mutation_id=?').bind(uid,mutationId).first<Row>();
  if(prior)return new Response(String(prior.response_json),{status:Number(prior.status),headers:{'content-type':'application/json; charset=utf-8',...CORS}});
  const response=await route(req,env);
  if(response.status<500){
    const text=await response.clone().text();
    await env.DB.prepare('INSERT OR REPLACE INTO mutation_receipts(user_id,mutation_id,status,response_json,created_at) VALUES(?,?,?,?,?)').bind(uid,mutationId,response.status,text,now()).run();
  }
  return response;
}

export default {async fetch(req:Request,env:Env){try{return await idempotentRoute(req,env)}catch(e){if(e instanceof AuthError)return json({error:e.message},401);console.error(e);return json({error:'서버 오류가 발생했습니다.'},500)}}} satisfies ExportedHandler<Env>;
