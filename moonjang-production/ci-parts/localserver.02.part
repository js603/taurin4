                if not row:return self.json(404,{"error":"글을 찾을 수 없습니다."})
                if row["author_id"]!=user_id:return self.json(403,{"error":"수정 권한이 없습니다."})
                data=self.read_json();content=str(data.get("content",row["content"])).strip();title=data.get("title",row["title"]);lead=data.get("leadSentence",row["lead_sentence"])
                if len(content)<2:return self.json(400,{"error":"본문이 너무 짧습니다."})
                conn.execute("UPDATE posts SET content=?,title=?,lead_sentence=?,updated_at=? WHERE id=?",(content,title,lead,now(),row["id"]));conn.commit();return self.json(200,{"post":post_dict(conn,conn.execute("SELECT * FROM posts WHERE id=?",(row["id"],)).fetchone(),user_id)})
            if m and method=="DELETE":
                row=conn.execute("SELECT * FROM posts WHERE id=? AND deleted_at IS NULL",(m.group(1),)).fetchone();
                if not row:return self.json(404,{"error":"글을 찾을 수 없습니다."})
                if row["author_id"]!=user_id:return self.json(403,{"error":"삭제 권한이 없습니다."})
                conn.execute("UPDATE posts SET deleted_at=?,updated_at=? WHERE id=?",(now(),now(),row["id"]));conn.commit();return self.json(200,{"ok":True})
            m=re.fullmatch(r"/v1/posts/([^/]+)/collect",path)
            if m and method=="POST":
                post_id=m.group(1);post=conn.execute("SELECT * FROM posts WHERE id=? AND deleted_at IS NULL",(post_id,)).fetchone()
                if not post or (post["visibility"]=="private" and post["author_id"]!=user_id):return self.json(404,{"error":"글을 찾을 수 없습니다."})
                collection=self.ensure_default_collection(conn,user_id);existing=conn.execute("SELECT 1 FROM collection_items WHERE collection_id=? AND post_id=?",(collection["id"],post_id)).fetchone()
                if existing:conn.execute("DELETE FROM collection_items WHERE collection_id=? AND post_id=?",(collection["id"],post_id));collected=False
                else:
                    conn.execute("INSERT INTO collection_items(collection_id,post_id,created_at) VALUES(?,?,?)",(collection["id"],post_id,now()));collected=True
                    author=conn.execute("SELECT author_id FROM posts WHERE id=?",(post_id,)).fetchone()
                    if author and author[0]!=user_id:self.notify(conn,author[0],"collection","누군가 당신의 문장을 간직했습니다.")
                conn.commit();return self.json(200,{"collected":collected})
            m=re.fullmatch(r"/v1/writers/([^/]+)/follow",path)
            if m and method=="POST":
                wid=m.group(1)
                if wid==user_id:return self.json(400,{"error":"자기 자신은 계속 읽기에 추가할 수 없습니다."})
                existing=conn.execute("SELECT 1 FROM follows WHERE follower_id=? AND writer_id=?",(user_id,wid)).fetchone()
                if existing:conn.execute("DELETE FROM follows WHERE follower_id=? AND writer_id=?",(user_id,wid));following=False
                else:conn.execute("INSERT INTO follows(follower_id,writer_id,created_at) VALUES(?,?,?)",(user_id,wid,now()));following=True;self.notify(conn,wid,"follow",f"{user['pen_name']}님이 당신을 계속 읽기 시작했습니다.")
                conn.commit();return self.json(200,{"following":following})
            m=re.fullmatch(r"/v1/posts/([^/]+)/comments",path)
            if m and method=="POST":
                post=conn.execute("SELECT * FROM posts WHERE id=? AND deleted_at IS NULL",(m.group(1),)).fetchone()
                if not post or (post["visibility"]=="private" and post["author_id"]!=user_id):return self.json(404,{"error":"글을 찾을 수 없습니다."})
                content=str(self.read_json().get("content","")).strip()
                if not 1<=len(content)<=500:return self.json(400,{"error":"한마디는 1~500자로 남겨주세요."})
                cid=uid();conn.execute("INSERT INTO comments(id,post_id,author_id,content,created_at) VALUES(?,?,?,?,?)",(cid,m.group(1),user_id,content,now()));author=conn.execute("SELECT author_id FROM posts WHERE id=?",(m.group(1),)).fetchone();
                if author and author[0]!=user_id:self.notify(conn,author[0],"comment",f"{user['pen_name']}님이 한마디를 남겼습니다.")
                conn.commit();c=conn.execute("SELECT * FROM comments WHERE id=?",(cid,)).fetchone();return self.json(201,{"comment":comment_dict(conn,c)})
            m=re.fullmatch(r"/v1/profiles/([^/]+)",path)
            if m and method=="GET":
                p=conn.execute("SELECT * FROM users WHERE handle=?",(m.group(1),)).fetchone()
                if not p:return self.json(404,{"error":"문장가를 찾을 수 없습니다."})
                following=bool(conn.execute("SELECT 1 FROM follows WHERE follower_id=? AND writer_id=?",(user_id,p["id"])).fetchone())
                rows=conn.execute("SELECT * FROM posts WHERE author_id=? AND deleted_at IS NULL AND (visibility='public' OR author_id=?) ORDER BY created_at DESC",(p["id"],user_id)).fetchall()
                return self.json(200,{"profile":profile_dict(p,following),"posts":[post_dict(conn,r,user_id) for r in rows]})
            if path=="/v1/collections" and method=="GET":
                rows=conn.execute("SELECT c.*,COUNT(ci.post_id) cnt FROM collections c LEFT JOIN collection_items ci ON ci.collection_id=c.id WHERE c.owner_id=? GROUP BY c.id ORDER BY c.created_at",(user_id,)).fetchall()
                return self.json(200,{"items":[{"id":r["id"],"title":r["title"],"description":r["description"],"visibility":r["visibility"],"itemCount":r["cnt"]} for r in rows]})
            if path=="/v1/collections" and method=="POST":
                d=self.read_json();title=str(d.get("title","")).strip();desc=str(d.get("description","")).strip();vis=d.get("visibility","private")
                if not title or len(title)>80 or vis not in ("private","public"):return self.json(400,{"error":"서랍 정보를 확인해주세요."})
                cid=uid();conn.execute("INSERT INTO collections(id,owner_id,title,description,visibility,created_at) VALUES(?,?,?,?,?,?)",(cid,user_id,title,desc,vis,now()));conn.commit();return self.json(201,{"collection":{"id":cid,"title":title,"description":desc,"visibility":vis,"itemCount":0}})
            m=re.fullmatch(r"/v1/collections/([^/]+)",path)
            if m and method=="GET":
                c=conn.execute("SELECT * FROM collections WHERE id=? AND (owner_id=? OR visibility='public')",(m.group(1),user_id)).fetchone()
                if not c:return self.json(404,{"error":"서랍을 찾을 수 없습니다."})
                if c["owner_id"]==user_id:
                    rows=conn.execute("SELECT p.* FROM collection_items ci JOIN posts p ON p.id=ci.post_id WHERE ci.collection_id=? AND p.deleted_at IS NULL ORDER BY ci.position,ci.created_at",(c["id"],)).fetchall()
                else:
                    rows=conn.execute("SELECT p.* FROM collection_items ci JOIN posts p ON p.id=ci.post_id WHERE ci.collection_id=? AND p.deleted_at IS NULL AND p.visibility='public' ORDER BY ci.position,ci.created_at",(c["id"],)).fetchall()
