  if(m&&method==='POST'){const p0=await env.DB.prepare('SELECT * FROM posts WHERE id=? AND deleted_at IS NULL').bind(m[1]).first<Row>();if(!p0||p0.visibility==='private'&&p0.author_id!==uid)return json({error:'글을 찾을 수 없습니다.'},404);const d=await body(req),content=String(d.content||'').trim();if(content.length<1||content.length>500)return json({error:'한마디는 1~500자로 남겨주세요.'},400);const id=uuid();await env.DB.prepare('INSERT INTO comments(id,post_id,author_id,content,created_at) VALUES(?,?,?,?,?)').bind(id,m[1],uid,content,now()).run();const p=await env.DB.prepare('SELECT author_id FROM posts WHERE id=?').bind(m[1]).first<Row>();if(p&&p.author_id!==uid)await notify(env,p.author_id,'comment',`${user.pen_name}님이 한마디를 남겼습니다.`);const c=await env.DB.prepare('SELECT * FROM comments WHERE id=?').bind(id).first<Row>();return json({comment:(await commentsOut(env,[c!],uid))[0]},201);}
  m=path.match(/^\/v1\/profiles\/([^/]+)$/);
  if(m&&method==='GET'){const p=await env.DB.prepare('SELECT * FROM users WHERE handle=?').bind(decodeURIComponent(m[1])).first<Row>();if(!p)return json({error:'문장가를 찾을 수 없습니다.'},404);const rows=(await env.DB.prepare("SELECT * FROM posts WHERE author_id=? AND deleted_at IS NULL AND (visibility='public' OR author_id=?) ORDER BY created_at DESC").bind(p.id,uid).all<Row>()).results;const posts=[];for(const r of rows)posts.push(await postOut(env,r,uid));return json({profile:await profile(env,p,uid),posts});}
  if(path==='/v1/collections'&&method==='GET'){const rows=(await env.DB.prepare('SELECT c.*,COUNT(ci.post_id) cnt FROM collections c LEFT JOIN collection_items ci ON ci.collection_id=c.id WHERE c.owner_id=? GROUP BY c.id ORDER BY c.created_at').bind(uid).all<Row>()).results;return json({items:rows.map(r=>({id:r.id,title:r.title,description:r.description,visibility:r.visibility,itemCount:Number(r.cnt)}))});}
  if(path==='/v1/collections'&&method==='POST'){const d=await body(req),title=String(d.title||'').trim(),vis=d.visibility||'private';if(!title||title.length>80||!['private','public'].includes(vis))return json({error:'서랍 정보를 확인해주세요.'},400);const id=uuid();await env.DB.prepare('INSERT INTO collections(id,owner_id,title,description,visibility,created_at) VALUES(?,?,?,?,?,?)').bind(id,uid,title,String(d.description||''),vis,now()).run();return json({collection:{id,title,description:String(d.description||''),visibility:vis,itemCount:0}},201);}
  m=path.match(/^\/v1\/collections\/([^/]+)$/);
  if(m&&method==='GET'){const c=await env.DB.prepare("SELECT * FROM collections WHERE id=? AND (owner_id=? OR visibility='public')").bind(m[1],uid).first<Row>();if(!c)return json({error:'서랍을 찾을 수 없습니다.'},404);const query=c.owner_id===uid?'SELECT p.* FROM collection_items ci JOIN posts p ON p.id=ci.post_id WHERE ci.collection_id=? AND p.deleted_at IS NULL ORDER BY ci.position,ci.created_at':"SELECT p.* FROM collection_items ci JOIN posts p ON p.id=ci.post_id WHERE ci.collection_id=? AND p.deleted_at IS NULL AND p.visibility='public' ORDER BY ci.position,ci.created_at";const rows=(await env.DB.prepare(query).bind(c.id).all<Row>()).results;const items=[];for(const r of rows)items.push(await postOut(env,r,uid));return json({collection:{id:c.id,title:c.title,description:c.description,visibility:c.visibility,itemCount:items.length,items}});}
  m=path.match(/^\/v1\/collections\/([^/]+)\/items$/);
  if(m&&method==='POST'){const c=await env.DB.prepare('SELECT * FROM collections WHERE id=? AND owner_id=?').bind(m[1],uid).first<Row>();if(!c)return json({error:'서랍을 찾을 수 없습니다.'},404);const d=await body(req);await env.DB.prepare('INSERT OR IGNORE INTO collection_items(collection_id,post_id,created_at) VALUES(?,?,?)').bind(c.id,String(d.postId||''),now()).run();return json({ok:true});}
  if(path==='/v1/drafts'&&method==='PUT'){const d=await body(req);await env.DB.prepare('INSERT INTO drafts(user_id,type,content,updated_at) VALUES(?,?,?,?) ON CONFLICT(user_id) DO UPDATE SET type=excluded.type,content=excluded.content,updated_at=excluded.updated_at').bind(uid,d.type||'sentence',String(d.content||''),now()).run();return json({ok:true});}
  if(path==='/v1/drafts'&&method==='GET'){const d=await env.DB.prepare('SELECT * FROM drafts WHERE user_id=?').bind(uid).first<Row>();return json({content:d?.content||'',type:d?.type||'sentence'});}
  if(path==='/v1/notifications'&&method==='GET'){const rows=(await env.DB.prepare('SELECT * FROM notifications WHERE user_id=? ORDER BY created_at DESC LIMIT 80').bind(uid).all<Row>()).results;return json({items:rows.map(r=>({id:r.id,kind:r.kind,message:r.message,createdAt:r.created_at,read:!!r.read_at}))});}
  if(path==='/v1/insights'&&method==='GET'){const month=new Date().toISOString().slice(0,7)+'-01T00:00:00.000Z';const pc=Number((await env.DB.prepare('SELECT COUNT(*) c FROM posts WHERE author_id=? AND created_at>=? AND deleted_at IS NULL').bind(uid,month).first<Row>())?.c||0);const saves=Number((await env.DB.prepare('SELECT COUNT(*) c FROM collection_items ci JOIN collections c ON c.id=ci.collection_id JOIN posts p ON p.id=ci.post_id WHERE p.author_id=? AND c.owner_id<>?').bind(uid,uid).first<Row>())?.c||0);const readers=Number((await env.DB.prepare("SELECT COUNT(DISTINCT e.user_id) c FROM events e JOIN posts p ON p.id=e.post_id WHERE p.author_id=? AND e.user_id<>? AND e.kind IN ('open','read_complete','revisit')").bind(uid,uid).first<Row>())?.c||0);const cross=Number((await env.DB.prepare("SELECT COUNT(*) c FROM (SELECT e.user_id FROM events e JOIN posts p ON p.id=e.post_id WHERE p.author_id=? AND e.user_id<>? AND e.kind IN ('open','read_complete','revisit') GROUP BY e.user_id HAVING COUNT(DISTINCT p.id)>=2)").bind(uid,uid).first<Row>())?.c||0);const narratives=[];if(saves)narratives.push(`당신의 문장들은 지금까지 ${saves}번 누군가의 서랍에 간직되었습니다.`);if(readers)narratives.push(`${readers}명의 서로 다른 독자가 당신의 문장을 읽었습니다.`);if(!narratives.length)narratives.push('첫 문장이 누군가에게 닿기 시작하면 이곳에 조용히 기록됩니다.');return json({postsThisMonth:pc,uniqueReaders:readers,collections:saves,crossReads:cross,narrative:narratives});}
  if(path==='/v1/search'&&method==='GET'){const q=(url.searchParams.get('q')||'').trim(),like=`%${q}%`;const rows=(await env.DB.prepare("SELECT DISTINCT p.* FROM posts p LEFT JOIN post_topics t ON t.post_id=p.id WHERE p.deleted_at IS NULL AND p.visibility='public' AND (p.content LIKE ? OR p.title LIKE ? OR t.topic LIKE ?) ORDER BY p.created_at DESC LIMIT 30").bind(like,like,like).all<Row>()).results;const ps=(await env.DB.prepare('SELECT * FROM users WHERE pen_name LIKE ? OR handle LIKE ? LIMIT 20').bind(like,like).all<Row>()).results;const posts=[];for(const r of rows)posts.push(await postOut(env,r,uid));return json({posts,profiles:await Promise.all(ps.map(x=>profile(env,x,uid)))});}
