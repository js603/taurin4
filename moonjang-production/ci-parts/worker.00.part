interface Env { DB: D1Database; ADMIN_KEY?: string }
type Row = Record<string, any>;
const CORS = {"Access-Control-Allow-Origin":"*","Access-Control-Allow-Headers":"Authorization, Content-Type, X-Admin-Key, X-Moonjang-Mutation-Id","Access-Control-Allow-Methods":"GET,POST,PUT,PATCH,DELETE,OPTIONS"};
const json=(data:unknown,status=200)=>new Response(JSON.stringify(data),{status,headers:{"content-type":"application/json; charset=utf-8",...CORS}});
const now=()=>new Date().toISOString();
const handleRe=/^[a-z0-9_]{3,24}$/;
function uuid(){return crypto.randomUUID()}
function randomToken(){const b=new Uint8Array(32);crypto.getRandomValues(b);return btoa(String.fromCharCode(...b)).replace(/\+/g,'-').replace(/\//g,'_').replace(/=+$/,'')}
async function sha256(s:string){const d=await crypto.subtle.digest('SHA-256',new TextEncoder().encode(s));return [...new Uint8Array(d)].map(x=>x.toString(16).padStart(2,'0')).join('')}
async function body(req:Request){const text=await req.text();if(text.length>1_000_000)throw new Error('요청이 너무 큽니다.');return text?JSON.parse(text):{}}
async function userFrom(req:Request,env:Env){const h=req.headers.get('Authorization')||'';if(!h.startsWith('Bearer '))throw new AuthError('로그인이 필요합니다.');const hash=await sha256(h.slice(7));const row=await env.DB.prepare("SELECT u.* FROM sessions s JOIN users u ON u.id=s.user_id WHERE s.token_hash=? AND s.expires_at>?").bind(hash,now()).first<Row>();if(!row)throw new AuthError('세션이 만료되었습니다.');return row}
class AuthError extends Error{}
async function profile(env:Env,row:Row,viewer?:string){let following=false;if(viewer&&viewer!==row.id)following=!!(await env.DB.prepare('SELECT 1 x FROM follows WHERE follower_id=? AND writer_id=?').bind(viewer,row.id).first());return{id:row.id,handle:row.handle,penName:row.pen_name,tagline:row.tagline||'',role:row.role,following}}
async function postOut(env:Env,row:Row,viewer:string){
  const a=await env.DB.prepare('SELECT * FROM users WHERE id=?').bind(row.author_id).first<Row>();
  const topics=(await env.DB.prepare('SELECT topic FROM post_topics WHERE post_id=? ORDER BY topic').bind(row.id).all<Row>()).results.map(x=>x.topic);
  const collected=!!(await env.DB.prepare('SELECT 1 x FROM collection_items ci JOIN collections c ON c.id=ci.collection_id WHERE c.owner_id=? AND ci.post_id=?').bind(viewer,row.id).first());
  const cc=Number((await env.DB.prepare('SELECT COUNT(*) c FROM collection_items ci JOIN collections c ON c.id=ci.collection_id WHERE ci.post_id=? AND c.owner_id<>?').bind(row.id,row.author_id).first<Row>())?.c||0);
  const comments=Number((await env.DB.prepare("SELECT COUNT(*) c FROM comments WHERE post_id=? AND deleted_at IS NULL").bind(row.id).first<Row>())?.c||0);
  const reads=Number((await env.DB.prepare("SELECT COUNT(DISTINCT user_id) c FROM events WHERE post_id=? AND kind IN ('open','read_complete','revisit') AND user_id<>?").bind(row.id,row.author_id).first<Row>())?.c||0);
  const revisits=Number((await env.DB.prepare("SELECT COUNT(DISTINCT user_id) c FROM events WHERE post_id=? AND kind='revisit' AND user_id<>?").bind(row.id,row.author_id).first<Row>())?.c||0);
  const age=Math.max(0,(Date.now()-Date.parse(row.created_at))/86400000);
  return{id:row.id,author:await profile(env,a!,viewer),type:row.type,title:row.title,content:row.content,leadSentence:row.lead_sentence,topics,createdAt:row.created_at,collected,collectionCount:cc,commentCount:comments,longRead:age>=2&&(cc>=1||reads>=2),revisited:revisits>=1,visibility:row.visibility}
}
async function ensureCollection(env:Env,userId:string){let c=await env.DB.prepare('SELECT * FROM collections WHERE owner_id=? ORDER BY created_at LIMIT 1').bind(userId).first<Row>();if(c)return c;const id=uuid();await env.DB.prepare('INSERT INTO collections(id,owner_id,title,description,visibility,created_at) VALUES(?,?,?,?,?,?)').bind(id,userId,'기본 서랍','오래 두고 싶은 문장들.','private',now()).run();return await env.DB.prepare('SELECT * FROM collections WHERE id=?').bind(id).first<Row>()}
async function notify(env:Env,userId:string,kind:string,message:string){await env.DB.prepare('INSERT INTO notifications(id,user_id,kind,message,created_at) VALUES(?,?,?,?,?)').bind(uuid(),userId,kind,message,now()).run()}
async function commentsOut(env:Env,rows:Row[],viewer:string){const out=[];for(const r of rows){const a=await env.DB.prepare('SELECT * FROM users WHERE id=?').bind(r.author_id).first<Row>();out.push({id:r.id,author:await profile(env,a!,viewer),content:r.content,createdAt:r.created_at})}return out}

async function route(req:Request,env:Env):Promise<Response>{
  const url=new URL(req.url),path=url.pathname,method=req.method;
  if(method==='OPTIONS')return new Response(null,{status:204,headers:CORS});
  if(method==='GET'&&path==='/health')return json({ok:true,service:'moonjang-d1'});
  if(method==='POST'&&path==='/v1/auth/anonymous'){
    const d=await body(req),handle=String(d.handle||'').trim().toLowerCase(),penName=String(d.penName||'').trim();
    if(!handleRe.test(handle))return json({error:'주소는 영문 소문자, 숫자, 밑줄 3~24자로 입력해주세요.'},400);
    if(penName.length<2||penName.length>30)return json({error:'필명은 2~30자로 입력해주세요.'},400);
    if(await env.DB.prepare('SELECT 1 x FROM users WHERE handle=?').bind(handle).first())return json({error:'이미 사용 중인 주소입니다.'},409);
    const id=uuid(),t=now(),raw=randomToken(),hash=await sha256(raw),expires=new Date(Date.now()+365*86400000).toISOString();
    await env.DB.batch([env.DB.prepare('INSERT INTO users(id,handle,pen_name,created_at) VALUES(?,?,?,?)').bind(id,handle,penName,t),env.DB.prepare('INSERT INTO collections(id,owner_id,title,description,visibility,created_at) VALUES(?,?,?,?,?,?)').bind(uuid(),id,'기본 서랍','오래 두고 싶은 문장들.','private',t),env.DB.prepare('INSERT INTO sessions(token_hash,user_id,created_at,expires_at) VALUES(?,?,?,?)').bind(hash,id,t,expires)]);
    const u=await env.DB.prepare('SELECT * FROM users WHERE id=?').bind(id).first<Row>();return json({token:raw,user:await profile(env,u!)},201);
  }
  const user=await userFrom(req,env),uid=user.id as string;
  if(method==='GET'&&path==='/v1/me')return json({user:await profile(env,user)});
  if(method==='DELETE'&&path==='/v1/me'){await env.DB.prepare('DELETE FROM users WHERE id=?').bind(uid).run();return json({ok:true});}
  if(method==='GET'&&path==='/v1/feed'){
    const rows=(await env.DB.prepare("SELECT p.*, CASE WHEN f.writer_id IS NOT NULL THEN 1 ELSE 0 END followed FROM posts p LEFT JOIN follows f ON f.writer_id=p.author_id AND f.follower_id=? WHERE p.deleted_at IS NULL AND p.visibility='public' AND p.author_id NOT IN (SELECT blocked_id FROM blocks WHERE blocker_id=?) ORDER BY followed DESC,p.created_at DESC LIMIT 60").bind(uid,uid).all<Row>()).results;const counts=new Map<string,number>(),items=[];for(const r of rows){const c=counts.get(r.author_id)||0;if(c>=2&&items.length<30)continue;counts.set(r.author_id,c+1);items.push(await postOut(env,r,uid));if(items.length>=40)break}return json({items});
  }
  if(method==='GET'&&path==='/v1/discover'){
