            if method=="POST" and path=="/v1/auth/anonymous":
                data=self.read_json();handle=str(data.get("handle","")).strip().lower();pen=str(data.get("penName","")).strip()
                if not HANDLE_RE.fullmatch(handle): return self.json(400,{"error":"주소는 영문 소문자, 숫자, 밑줄 3~24자로 입력해주세요."})
                if len(pen)<2 or len(pen)>30: return self.json(400,{"error":"필명은 2~30자로 입력해주세요."})
                if conn.execute("SELECT 1 FROM users WHERE handle=?",(handle,)).fetchone(): return self.json(409,{"error":"이미 사용 중인 주소입니다."})
                user_id=uid();t=now();conn.execute("INSERT INTO users(id,handle,pen_name,created_at) VALUES(?,?,?,?)",(user_id,handle,pen,t));self.ensure_default_collection(conn,user_id)
                raw=secrets.token_urlsafe(32);conn.execute("INSERT INTO sessions(token_hash,user_id,created_at,expires_at) VALUES(?,?,?,?)",(token_hash(raw),user_id,t,(datetime.now(timezone.utc)+timedelta(days=365)).isoformat()));conn.commit()
                u=conn.execute("SELECT * FROM users WHERE id=?",(user_id,)).fetchone();return self.json(201,{"token":raw,"user":profile_dict(u)})
            user=self.auth(conn); user_id=user["id"]
            mutation_id=(self.headers.get("X-Moonjang-Mutation-Id","") or "").strip()[:120]
            if mutation_id and method in MUTATION_METHODS:
                prior=conn.execute("SELECT status,response_json FROM mutation_receipts WHERE user_id=? AND mutation_id=?",(user_id,mutation_id)).fetchone()
                if prior:
                    return self.json(int(prior["status"]),json.loads(prior["response_json"]))
                self._mutation_ctx=(conn,user_id,mutation_id)
            if method=="GET" and path=="/v1/me": return self.json(200,{"user":profile_dict(user)})
            if method=="DELETE" and path=="/v1/me":
                conn.execute("DELETE FROM users WHERE id=?",(user_id,));conn.commit();return self.json(200,{"ok":True})
            if method=="GET" and path=="/v1/feed":
                blocked=self.blocked_ids(conn,user_id); params=[user_id]; where="p.deleted_at IS NULL AND p.visibility='public' AND p.author_id NOT IN (SELECT blocked_id FROM blocks WHERE blocker_id=?)"
                rows=conn.execute(f"""SELECT p.*, (CASE WHEN f.writer_id IS NOT NULL THEN 1 ELSE 0 END) followed,
                  (SELECT COUNT(*) FROM collection_items ci WHERE ci.post_id=p.id) saves,
                  (SELECT COUNT(*) FROM events e WHERE e.post_id=p.id AND e.kind IN ('read_complete','revisit')) reads
                  FROM posts p LEFT JOIN follows f ON f.writer_id=p.author_id AND f.follower_id=? WHERE {where}
                  ORDER BY (followed*3 + CASE WHEN julianday('now')-julianday(p.created_at)<7 THEN 1 ELSE 0 END + MIN(saves,5)*0.4 + MIN(reads,5)*0.2) DESC, p.created_at DESC LIMIT 60""",(user_id,user_id)).fetchall()
                # Exposure diversity: cap writer occurrences in first 30.
                out=[];counts={}
                for r in rows:
                    c=counts.get(r["author_id"],0)
                    if c>=2 and len(out)<30: continue
                    counts[r["author_id"]]=c+1;out.append(post_dict(conn,r,user_id))
                    if len(out)>=40: break
                return self.json(200,{"items":out})
            if method=="GET" and path=="/v1/discover":
                rows=conn.execute("SELECT * FROM posts WHERE deleted_at IS NULL AND visibility='public' ORDER BY created_at DESC LIMIT 80").fetchall()
                posts=[post_dict(conn,r,user_id) for r in rows if r["author_id"] not in self.blocked_ids(conn,user_id)]
                long_read=sorted(posts,key=lambda p:(p["longRead"],p["collectionCount"]),reverse=True)[:8]
                nw=conn.execute("SELECT * FROM users WHERE id<>? ORDER BY created_at DESC LIMIT 8",(user_id,)).fetchall()
                editorial_rows=conn.execute("SELECT p.* FROM editorial_features ef JOIN posts p ON p.id=ef.post_id WHERE p.deleted_at IS NULL ORDER BY ef.featured_at DESC LIMIT 8").fetchall()
                random_post=posts[-1] if posts else None
                public_collections=conn.execute("SELECT c.*,COUNT(ci.post_id) cnt FROM collections c LEFT JOIN collection_items ci ON ci.collection_id=c.id WHERE c.visibility='public' AND c.owner_id<>? GROUP BY c.id ORDER BY c.created_at DESC LIMIT 8",(user_id,)).fetchall()
                return self.json(200,{"longRead":long_read,"newWriters":[profile_dict(r) for r in nw],"editorial":[post_dict(conn,r,user_id) for r in editorial_rows],"publicCollections":[{"id":r["id"],"title":r["title"],"description":r["description"],"visibility":r["visibility"],"itemCount":r["cnt"]} for r in public_collections],"random":random_post})
            m=re.fullmatch(r"/v1/posts/([^/]+)",path)
            if m and method=="GET":
                row=conn.execute("SELECT * FROM posts WHERE id=? AND deleted_at IS NULL",(m.group(1),)).fetchone()
                if not row:return self.json(404,{"error":"글을 찾을 수 없습니다."})
                if row["visibility"]=="private" and row["author_id"]!=user_id:return self.json(404,{"error":"글을 찾을 수 없습니다."})
                cs=conn.execute("SELECT * FROM comments WHERE post_id=? AND deleted_at IS NULL ORDER BY created_at",(m.group(1),)).fetchall()
                return self.json(200,{"post":post_dict(conn,row,user_id),"comments":[comment_dict(conn,c) for c in cs]})
            if path=="/v1/posts" and method=="POST":
                data=self.read_json();typ=data.get("type","sentence");content=str(data.get("content","")).strip();title=str(data.get("title") or "").strip() or None;lead=str(data.get("leadSentence") or "").strip() or None;topics=data.get("topics") or [];visibility=data.get("visibility","public")
                if typ not in ("sentence","article") or len(content)<2 or len(content)>20000 or visibility not in ("public","unlisted","private"):return self.json(400,{"error":"글의 형식, 공개 범위 또는 길이를 확인해주세요."})
                age_days=max(0,(datetime.now(timezone.utc)-datetime.fromisoformat(user["created_at"])).days);daily_limit=5 if age_days<7 else 20
                today=datetime.now(timezone.utc).strftime('%Y-%m-%dT00:00:00+00:00');posted_today=conn.execute("SELECT COUNT(*) FROM posts WHERE author_id=? AND created_at>=? AND deleted_at IS NULL",(user_id,today)).fetchone()[0]
                if posted_today>=daily_limit:return self.json(429,{"error":f"오늘은 {daily_limit}개의 글까지 남길 수 있습니다. 내일 다시 만나요."})
                if conn.execute("SELECT 1 FROM posts WHERE author_id=? AND content=? AND deleted_at IS NULL AND created_at>=datetime('now','-30 day')",(user_id,content)).fetchone():return self.json(409,{"error":"같은 문장을 최근에 이미 남겼습니다."})
                pid=uid();t=now();conn.execute("INSERT INTO posts(id,author_id,type,title,content,lead_sentence,visibility,created_at,updated_at) VALUES(?,?,?,?,?,?,?,?,?)",(pid,user_id,typ,title,content,lead,visibility,t,t))
                for topic in list(dict.fromkeys([str(x).strip()[:30] for x in topics if str(x).strip()]))[:3]:conn.execute("INSERT INTO post_topics(post_id,topic) VALUES(?,?)",(pid,topic))
                conn.execute("DELETE FROM drafts WHERE user_id=?",(user_id,));conn.commit();row=conn.execute("SELECT * FROM posts WHERE id=?",(pid,)).fetchone();return self.json(201,{"post":post_dict(conn,row,user_id)})
            if m and method=="PATCH":
                row=conn.execute("SELECT * FROM posts WHERE id=? AND deleted_at IS NULL",(m.group(1),)).fetchone();
