:root{font-family:Inter,Pretendard,"Apple SD Gothic Neo","Noto Sans KR",system-ui,sans-serif;color:#1d1b18;background:#f6f1e8;font-synthesis:none;--paper:#f6f1e8;--ink:#1d1b18;--muted:#777168;--line:#d9d0c4;--accent:#3d5b4f;--surface:#fbf8f2}*{box-sizing:border-box}html,body,#root{margin:0;min-height:100%;background:var(--paper)}button,input,textarea{font:inherit;color:inherit}button{cursor:pointer}.app{min-height:100vh;padding-bottom:78px}.topbar{position:sticky;top:0;z-index:10;height:62px;display:flex;align-items:center;justify-content:space-between;padding:env(safe-area-inset-top) 22px 0;background:color-mix(in srgb,var(--paper) 92%,transparent);backdrop-filter:blur(16px);border-bottom:1px solid rgba(80,70,60,.08)}.brand-button,.brand{font-family:Georgia,"Noto Serif KR",serif;font-weight:700;letter-spacing:-.04em}.brand-button{font-size:22px;background:none;border:0}.brand.big{font-size:30px}.top-actions{display:flex;gap:16px}.top-actions button,.quiet-action,.author-link,.back{border:0;background:none;padding:6px 0;color:var(--muted)}.content{width:min(100%,760px);margin:0 auto;padding:28px 22px 42px}.section-heading{padding:14px 0 34px}.section-heading .date{color:var(--muted);font-size:13px;margin:0 0 9px}.section-heading h1{font-family:Georgia,"Noto Serif KR",serif;font-size:30px;line-height:1.3;letter-spacing:-.035em;margin:0;font-weight:600}.section-heading p{color:var(--muted)}.bottom-nav{position:fixed;left:0;right:0;bottom:0;z-index:20;display:grid;grid-template-columns:repeat(5,1fr);height:68px;padding-bottom:env(safe-area-inset-bottom);background:rgba(246,241,232,.96);border-top:1px solid var(--line);backdrop-filter:blur(16px)}.bottom-nav button{border:0;background:none;color:#8b847a;font-size:13px}.bottom-nav button.selected{color:var(--ink);font-weight:700}.post-list{display:flex;flex-direction:column}.post-card{padding:34px 0 30px;border-bottom:1px solid var(--line)}.post-body-button{width:100%;text-align:left;border:0;background:none;padding:0}.sentence,.article-lead{font-family:Georgia,"Noto Serif KR",serif;white-space:pre-wrap;word-break:keep-all;font-size:25px;line-height:1.72;letter-spacing:-.03em;margin:0}.article-lead{font-size:22px}.post-title{font-family:Georgia,"Noto Serif KR",serif;font-size:16px;margin:0 0 12px;color:var(--muted);font-weight:500}.read-more{display:block;color:var(--muted);font-size:12px;margin-top:15px}.post-meta{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin-top:20px;color:var(--muted);font-size:12px}.post-meta .author-link{color:var(--ink);font-weight:600}.post-actions{display:flex;gap:20px;margin-top:10px}.quiet-action{font-size:13px}.quiet-action.active{color:var(--accent);font-weight:700}.editorial-break{text-align:center;color:#8b847a;font-family:Georgia,"Noto Serif KR",serif;font-size:13px;padding:28px 0 3px}.search{display:flex;gap:10px;margin-bottom:38px}.search input,.create-row input,.comment-form input,.settings-block input,.onboarding input,.topic-input,.title-input{width:100%;border:0;border-bottom:1px solid var(--line);background:transparent;padding:13px 2px;outline:none}.search button,.create-row button,.comment-form button,.settings-block button{border:1px solid var(--line);background:var(--surface);padding:10px 14px;border-radius:3px}.discover-rail,.writer-section{margin:36px 0}.discover-rail h2,.writer-section h2,.subhead,.comments h2,.insight-panel h2,.profile-posts h2{font-size:14px;margin:0 0 14px}.rail{display:grid;grid-auto-flow:column;grid-auto-columns:82%;overflow-x:auto;gap:12px;scroll-snap-type:x mandatory;padding-bottom:4px}.rail button{scroll-snap-align:start;border:1px solid var(--line);background:var(--surface);padding:20px;text-align:left;min-height:160px}.rail p{font-family:Georgia,"Noto Serif KR",serif;font-size:18px;line-height:1.65;margin:0}.rail span{display:block;color:var(--muted);font-size:12px;margin-top:16px}.writer-row{width:100%;display:flex;justify-content:space-between;align-items:center;text-align:left;padding:14px 0;border:0;border-bottom:1px solid var(--line);background:none}.writer-row span{color:var(--muted);font-size:13px}.random-card{border-top:1px solid var(--line);padding-top:28px;margin-top:42px}.random-card>span{font-size:12px;color:var(--muted)}.random-card button{border:0;background:none;width:100%;text-align:left;font-family:Georgia,"Noto Serif KR",serif;font-size:24px;line-height:1.65;padding:18px 0}.writer{min-height:70vh}.writer-head{display:flex;justify-content:space-between;align-items:center;margin-bottom:28px}.segmented{display:flex;gap:14px}.segmented button{border:0;background:none;color:var(--muted);padding:8px 0}.segmented button.active{color:var(--ink);border-bottom:1px solid var(--ink)}.primary{border:0;background:var(--ink);color:#fff;padding:14px 18px}.primary.small{padding:9px 15px}.editor{width:100%;min-height:48vh;resize:none;border:0;background:transparent;outline:none;font-family:Georgia,"Noto Serif KR",serif;font-size:24px;line-height:1.8;padding:12px 0}.title-input{font-family:Georgia,"Noto Serif KR",serif;font-size:27px}.topic-input{margin-top:22px}.draft-state,.fine{font-size:11px;color:var(--muted);line-height:1.55}.create-row{display:flex;gap:10px;margin-bottom:22px}.collection-list{display:flex;flex-direction:column}.collection-list>button{border:0;border-bottom:1px solid var(--line);background:none;text-align:left;padding:22px 0;display:flex;flex-direction:column;gap:7px}.collection-list span{font-size:12px;color:var(--muted)}.profile-header{display:flex;gap:18px;align-items:flex-start;padding:18px 0 34px}.avatar{width:52px;height:52px;border:1px solid var(--line);display:grid;place-items:center;border-radius:50%;font-family:Georgia,"Noto Serif KR",serif;font-size:20px}.profile-header h1{font-family:Georgia,"Noto Serif KR",serif;margin:0 0 5px;font-size:27px}.profile-header p{margin:5px 0;color:var(--muted);font-size:13px}.follow{border:1px solid var(--ink);background:none;padding:8px 13px;margin-top:10px}.insight-panel{border-top:1px solid var(--line);border-bottom:1px solid var(--line);padding:24px 0;margin-bottom:28px}.metrics{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin:15px 0 20px}.metrics>div{display:flex;flex-direction:column;gap:4px}.metrics strong{font-family:Georgia,"Noto Serif KR",serif;font-size:22px}.metrics span{font-size:10px;color:var(--muted)}.insight-panel>p{font-size:13px;color:var(--muted)}.profile-posts>button,.profile-post{width:100%;border:0;border-bottom:1px solid var(--line);background:none;text-align:left;padding:20px 0;font-family:Georgia,"Noto Serif KR",serif;font-size:18px;line-height:1.6}.overlay{position:fixed;inset:0;z-index:30;background:var(--paper);overflow-y:auto}.overlay-sheet{width:min(100%,760px);margin:0 auto;padding:calc(env(safe-area-inset-top) + 22px) 22px 52px}.reading{padding:24px 0}.reading header{display:flex;justify-content:space-between;font-size:12px;color:var(--muted);margin-bottom:35px}.reading h1{font-family:Georgia,"Noto Serif KR",serif;font-size:3